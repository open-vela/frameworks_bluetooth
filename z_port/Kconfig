config BLUETOOTH_Z_PORT
	bool "Zephyr Bluetooth API Port Layer"
	default n
	depends on BLUETOOTH_FRAMEWORK
	help
	  Enable the Zephyr Bluetooth API port layer.
	  This provides an adaptation layer to convert Zephyr Bluetooth
	  API calls to the framework Bluetooth API.
