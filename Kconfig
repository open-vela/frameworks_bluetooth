		bool "classic bt stack use bluelet"
		select LIB_BLUELET
	config OBELISK_NOT_SUPPORT_CLASSIC_BT
		bool "not support classic bt stack"
endchoice
endif #BLUETOOTH_BREDR_SUPPORT

if BLUETOOTH_BLE_SUPPORT
